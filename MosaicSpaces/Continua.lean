module

public import MosaicSpaces.Mosaic
public import Mathlib.Analysis.SpecificLimits.Basic
public import Mathlib.Topology.Compactification.OnePoint.Basic
public import Mathlib.Topology.Connected.PathConnected

/-!
# Metric continua in mosaic spaces (article: Corollary 2.6, Proposition 2.7 last assertion)

* `MosaicSpaces.isMetricContinuum_iUnion_of_null` is **Corollary 2.6(3)**: metric continua
  `K n` through a point `x`, all but finitely many inside every open set containing `x`, have a
  union which is a metric continuum. The article's proof maps the one-point compactification of
  the topological sum `Σ n, K n` onto the union; here the metrizability of that compactification
  is proved by a continuous injection into `OnePoint ℕ × Π n, K n`.
* `MosaicSpaces.IsMetricContinuum.union` is **Corollary 2.6(1)**.
* `MosaicSpaces.isMetricContinuum_range_path` is the compactness part of **Corollary 2.6(2)**.
* `MosaicSpaces.IsMosaicSpace.of_isOpen` is the last assertion of **Proposition 2.7**.

Nothing here assumes the ambient space to be Hausdorff.
-/

@[expose] public section

open Set Filter Topology TopologicalSpace OnePoint

namespace MosaicSpaces

universe u

/-! ### A countable null family of compact metrizable spaces -/

section NullFamily

variable {K : ℕ → Type u} [∀ n, TopologicalSpace (K n)] [∀ n, CompactSpace (K n)]

theorem isCompact_setOf_fst_lt (N : ℕ) : IsCompact {p : Σ n, K n | p.1 < N} := by
  have e : {p : Σ n, K n | p.1 < N} = ⋃ n ∈ Iio N, range (Sigma.mk n : K n → Σ n, K n) := by
    ext ⟨n, a⟩
    simp only [mem_setOf_eq, mem_iUnion, mem_range, mem_Iio, exists_prop]
    constructor
    · intro h
      exact ⟨n, h, a, rfl⟩
    · rintro ⟨m, hm, b, hb⟩
      cases hb
      exact hm
  rw [e]
  exact (finite_Iio N).isCompact_biUnion fun n _ => isCompact_range continuous_sigmaMk

theorem isClosed_setOf_fst (s : Set ℕ) : IsClosed {p : Σ n, K n | p.1 ∈ s} :=
  isClosed_sigma_iff.2 fun n => by
    by_cases h : n ∈ s
    · convert isClosed_univ
      ext a
      simp [h]
    · convert isClosed_empty
      ext a
      simp [h]

/-- In the topological sum of compact spaces `K n`, the cocompact filter is generated by the
sets `{p | N ≤ p.1}`. -/
theorem eventually_coclosedCompact_le (N : ℕ) :
    ∀ᶠ p in coclosedCompact (Σ n, K n), N ≤ p.1 := by
  have h : {p : Σ n, K n | p.1 < N}ᶜ ∈ coclosedCompact (Σ n, K n) :=
    hasBasis_coclosedCompact.mem_iff.2
      ⟨_, ⟨isClosed_setOf_fst (Iio N), isCompact_setOf_fst_lt N⟩, Subset.rfl⟩
  filter_upwards [h] with p hp
  exact not_lt.1 hp

variable [∀ n, MetrizableSpace (K n)]

/-- The one-point compactification of a countable topological sum of compact metrizable spaces
is metrizable, given base points (used in Corollary 2.6(3)). It is compact, and it injects
continuously into the metrizable space `OnePoint ℕ × Π n, K n`. -/
theorem metrizableSpace_onePoint_sigma (b : ∀ n, K n) :
    MetrizableSpace (OnePoint (Σ n, K n)) := by
  classical
  let F : OnePoint (Σ n, K n) → OnePoint ℕ × (∀ n, K n) :=
    fun c => c.elim ((∞ : OnePoint ℕ), b) fun p => ((p.1 : OnePoint ℕ), Function.update b p.1 p.2)
  have hfst : Tendsto (fun p : Σ n, K n => p.1) (coclosedCompact (Σ n, K n)) atTop :=
    tendsto_atTop.2 fun N => eventually_coclosedCompact_le N
  have hF : Continuous F := by
    rw [OnePoint.continuous_iff]
    refine ⟨Tendsto.prodMk_nhds ?_ ?_, ?_⟩
    · exact ((OnePoint.continuous_iff_from_nat (fun c : OnePoint ℕ => c)).1 continuous_id).comp
        hfst
    · refine tendsto_pi_nhds.2 fun m => tendsto_const_nhds.congr' ?_
      filter_upwards [eventually_coclosedCompact_le (K := K) (m + 1)] with p hp
      exact (Function.update_of_ne (Nat.ne_of_lt (Nat.lt_of_succ_le hp)) _ _).symm
    · refine continuous_sigma fun n => ?_
      show Continuous fun a : K n => (((n : ℕ) : OnePoint ℕ), Function.update b n a)
      exact continuous_const.prodMk (continuous_const.update n continuous_id)
  have hinj : Function.Injective F := by
    rintro (_ | ⟨n, a⟩) (_ | ⟨m, c⟩) h
    · rfl
    · exact absurd (congrArg Prod.fst h) (OnePoint.infty_ne_coe m)
    · exact absurd (congrArg Prod.fst h) (OnePoint.coe_ne_infty n)
    · have h1 : ((n : ℕ) : OnePoint ℕ) = (m : OnePoint ℕ) := congrArg Prod.fst h
      have hnm : n = m := OnePoint.coe_injective h1
      subst hnm
      have h2 : Function.update b n a n = Function.update b n c n :=
        congrArg (fun q : OnePoint ℕ × (∀ n, K n) => q.2 n) h
      rw [Function.update_self, Function.update_self] at h2
      rw [h2]
  exact (hF.isClosedEmbedding hinj).metrizableSpace

end NullFamily

/-! ### Corollary 2.6 -/

variable {X : Type u} [TopologicalSpace X]

/-- **Corollary 2.6(3)** (`cor:image`(3)). In a sequential space with unique sequential limits
(for instance a mosaic space), let `K n` be metric continua containing a point `x` such that every
open set containing `x` contains `K n` for all but finitely many `n`. Then `⋃ n, K n` is a metric
continuum. -/
theorem isMetricContinuum_iUnion_of_null [SequentialSpace X] (hX : UniqueSeqLimits X) {x : X}
    {K : ℕ → Set X} (hK : ∀ n, IsMetricContinuum (K n)) (hx : ∀ n, x ∈ K n)
    (hnull : ∀ O : Set X, IsOpen O → x ∈ O → ∀ᶠ n in atTop, K n ⊆ O) :
    IsMetricContinuum (⋃ n, K n) := by
  haveI : ∀ n, CompactSpace (K n) := fun n => isCompact_iff_compactSpace.1 (hK n).1
  haveI : ∀ n, MetrizableSpace (K n) := fun n => (hK n).2.2
  haveI := metrizableSpace_onePoint_sigma (K := fun n => ↥(K n)) (fun n => ⟨x, hx n⟩)
  let g : OnePoint (Σ n, ↥(K n)) → X := fun c => c.elim x fun p => (p.2 : X)
  have hg : Continuous g := by
    rw [OnePoint.continuous_iff]
    refine ⟨?_, continuous_sigma fun n => continuous_subtype_val⟩
    refine (nhds_basis_opens x).tendsto_right_iff.2 fun O hO => ?_
    obtain ⟨N, hN⟩ := eventually_atTop.1 (hnull O hO.2 hO.1)
    filter_upwards [eventually_coclosedCompact_le (K := fun n => ↥(K n)) N] with p hp
    exact hN p.1 hp p.2.2
  have e : range g = ⋃ n, K n := by
    ext y
    constructor
    · rintro ⟨c, rfl⟩
      rcases c with _ | ⟨n, a⟩
      · exact mem_iUnion.2 ⟨0, hx 0⟩
      · exact mem_iUnion.2 ⟨n, a.2⟩
    · intro hy
      obtain ⟨n, hn⟩ := mem_iUnion.1 hy
      exact ⟨((⟨n, ⟨y, hn⟩⟩ : Σ n, ↥(K n)) : OnePoint (Σ n, ↥(K n))), rfl⟩
  have h := range_closed_compact_metrizable hX hg
  rw [e] at h
  exact ⟨h.2.1, ⟨⟨x, mem_iUnion.2 ⟨0, hx 0⟩⟩,
    isPreconnected_iUnion ⟨x, mem_iInter.2 hx⟩ fun n => (hK n).2.1.2⟩, h.2.2⟩

/-- A point is a metric continuum (in a sequential space with unique sequential limits). -/
theorem isMetricContinuum_singleton [SequentialSpace X] (hX : UniqueSeqLimits X) (x : X) :
    IsMetricContinuum ({x} : Set X) := by
  have h := range_closed_compact_metrizable hX (continuous_const : Continuous fun _ : Unit => x)
  rw [range_const] at h
  exact ⟨isCompact_singleton, isConnected_singleton, h.2.2⟩

/-- **Corollary 2.6(1)** (`cor:image`(1)). The union of two metric continua with a common point is
a metric continuum. -/
theorem IsMetricContinuum.union [SequentialSpace X] (hX : UniqueSeqLimits X) {K L : Set X}
    (hK : IsMetricContinuum K) (hL : IsMetricContinuum L) (hKL : (K ∩ L).Nonempty) :
    IsMetricContinuum (K ∪ L) := by
  obtain ⟨x, hxK, hxL⟩ := hKL
  let f : ℕ → Set X := fun n => if n = 0 then K else if n = 1 then L else {x}
  have hf : ∀ n, IsMetricContinuum (f n) := by
    intro n
    simp only [f]
    split_ifs
    · exact hK
    · exact hL
    · exact isMetricContinuum_singleton hX x
  have hxf : ∀ n, x ∈ f n := by
    intro n
    simp only [f]
    split_ifs
    · exact hxK
    · exact hxL
    · exact mem_singleton x
  have e : (⋃ n, f n) = K ∪ L := by
    apply Subset.antisymm
    · refine iUnion_subset fun n => ?_
      simp only [f]
      split_ifs
      · exact subset_union_left
      · exact subset_union_right
      · exact singleton_subset_iff.2 (Or.inl hxK)
    · rintro y (hy | hy)
      · exact mem_iUnion.2 ⟨0, by simpa [f] using hy⟩
      · exact mem_iUnion.2 ⟨1, by simpa [f] using hy⟩
  rw [← e]
  refine isMetricContinuum_iUnion_of_null hX hf hxf fun O _ hxO => ?_
  filter_upwards [eventually_ge_atTop 2] with n hn
  have h0 : n ≠ 0 := by omega
  have h1 : n ≠ 1 := by omega
  simp only [f, h0, h1, if_false]
  exact singleton_subset_iff.2 hxO

/-- **Corollary 2.6(2)**, compactness part (`cor:image`(2)). The image of a path in a sequential
space with unique sequential limits is a metric continuum. -/
theorem isMetricContinuum_range_path [SequentialSpace X] (hX : UniqueSeqLimits X) {a b : X}
    (γ : Path a b) : IsMetricContinuum (range γ) :=
  let h := range_closed_compact_metrizable hX γ.continuous
  ⟨h.2.1, isConnected_range γ.continuous, h.2.2⟩

/-- **Corollary 2.6(2)**, second part: any two points of a path connected subset lie in a metric
continuum contained in it. -/
theorem IsPathConnected.exists_metricContinuum [SequentialSpace X] (hX : UniqueSeqLimits X)
    {s : Set X} (hs : IsPathConnected s) {a b : X} (ha : a ∈ s) (hb : b ∈ s) :
    ∃ L ⊆ s, IsMetricContinuum L ∧ a ∈ L ∧ b ∈ L := by
  have hj : JoinedIn s a b := hs.joinedIn a ha b hb
  refine ⟨range hj.somePath, ?_, isMetricContinuum_range_path hX _, ⟨0, by simp⟩, ⟨1, by simp⟩⟩
  rintro _ ⟨t, rfl⟩
  exact hj.somePath_mem t

/-! ### Open subspaces (Proposition 2.7, last assertion) -/

/-- An open subspace of a sequential space is sequential. -/
theorem IsOpen.sequentialSpace_subtype [SequentialSpace X] {U : Set X} (hU : IsOpen U) :
    SequentialSpace U := by
  refine ⟨fun M hM => ?_⟩
  -- the complement of `M` in `U`, seen in `X`, is open
  let T : Set X := ((↑) '' M) ∪ Uᶜ
  have hT : IsSeqClosed T := by
    intro u p hu hup
    by_cases hp : p ∈ U
    · have hev : ∀ᶠ n in atTop, u n ∈ U := hup.eventually (hU.mem_nhds hp)
      obtain ⟨N, hN⟩ := eventually_atTop.1 hev
      let v : ℕ → U := fun n => ⟨u (n + N), hN _ (Nat.le_add_left N n)⟩
      have hv : Tendsto v atTop (𝓝 ⟨p, hp⟩) :=
        tendsto_subtype_rng.2 (hup.comp (tendsto_add_atTop_nat N))
      have hvM : ∀ n, v n ∈ M := by
        intro n
        rcases hu (n + N) with ⟨m, hm, hme⟩ | hn
        · have : m = v n := Subtype.ext hme
          rw [← this]
          exact hm
        · exact absurd (hN _ (Nat.le_add_left N n)) hn
      exact Or.inl ⟨⟨p, hp⟩, hM hvM hv, rfl⟩
    · exact Or.inr hp
  have hTc : IsClosed T := hT.isClosed
  have e : Mᶜ = (↑) ⁻¹' Tᶜ := by
    ext ⟨y, hy⟩
    simp only [mem_compl_iff, mem_preimage, T, mem_union, mem_image, not_or, not_not]
    constructor
    · intro hyM
      refine ⟨?_, hy⟩
      rintro ⟨z, hz, hzy⟩
      have : z = ⟨y, hy⟩ := Subtype.ext hzy
      rw [this] at hz
      exact hyM hz
    · rintro ⟨h, -⟩ hyM
      exact h ⟨_, hyM, rfl⟩
  rw [← isOpen_compl_iff, e]
  exact hTc.isOpen_compl.preimage continuous_subtype_val

theorem UniqueSeqLimits.subtype (hX : UniqueSeqLimits X) (U : Set X) : UniqueSeqLimits U :=
  fun _ _ _ ha hb => Subtype.ext (hX (tendsto_subtype_rng.1 ha) (tendsto_subtype_rng.1 hb))

/-- **Proposition 2.7**, last assertion: every open subspace of a mosaic space is a mosaic space.
(The article says "nonempty"; the empty subspace is a mosaic space too, with the empty family.) -/
theorem IsMosaicSpace.of_isOpen (h : IsMosaicSpace X) {U : Set X} (hU : IsOpen U) :
    IsMosaicSpace U := by
  haveI := h.sequentialSpace
  exact isMosaicSpace_iff.2 ⟨IsOpen.sequentialSpace_subtype hU, h.uniqueSeqLimits.subtype U⟩

end MosaicSpaces
