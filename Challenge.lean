/-!
# Mosaic spaces generated by continua and by Peano continua — statement surface

Statements of the results of the article "Mosaic spaces generated by continua and by Peano
continua: answers to three questions recorded by Lavallee" (Lucas Alves de Almeida) that this
project formalizes. Every theorem below is closed by `sorry` **in this file only**; it is proved,
under the same name and with the same statement, in `Solution.lean` from the library
`MosaicSpaces`. The definitions are copied verbatim from the library.

Conventions (see `docs/ARCHITECTURE.md`):

* Mosaic spaces are defined intrinsically: `X` is a mosaic space if its topology is coherent with a
  covering family of closed subspaces which are compact and metrizable (`IsMosaicSpace`). No
  Hausdorff, first countability or metrizability assumption is made on `X` anywhere.
* "Metric continuum" is `IsMetricContinuum`: compact, connected (hence nonempty) and metrizable as
  a subspace.
* Local properties are in the article's open-set form; "locally path connected" is Mathlib's
  `LocallyPathConnectedSpace`.
* All three questions are answered as asked: **Q3** by `answer_Q3` (a Tychonoff, locally arcwise
  connected mosaic space that is not a quasi-curve space); **Q2** by `answer_Q2` (Corollary 6.4
  in full); **Q1a and Q1b are answered via the cone over `G`**, not via the
  article's space `E(K)`, which is not formalized.
* Scope. Not formalized (examples): Section 3 (`E(K)`, Constructions 3.1 and 3.3, Lemma 3.2,
  Theorem 3.4, Corollary 3.5, Remark 3.6) and the Appendix; Section 5's van Douwen space (Lemma
  5.1, Proposition 5.3); Example 7.3 (`𝖼Z`); the strictness claims of Theorem 7.4 that use `E(K)`
  or `𝖼Z`; Curtis's example in Remark 3.7. The Hahn–Mazurkiewicz theorem (a classical fact quoted
  in the conventions) is not formalized; no statement here depends on it.
* Statements about the specific spaces `G` and `𝖼G` are existential: `theorem_4_11` packs the
  properties of `G` for one witness.
-/

@[expose] public section

open Set Filter Topology TopologicalSpace

namespace MosaicSpaces

universe u

section Defs

variable {X : Type u} [TopologicalSpace X]

/-- Convergent sequences in `X` have unique limits ("unique sequential limits"). This is weaker
than the Hausdorff property. -/
def UniqueSeqLimits (X : Type u) [TopologicalSpace X] : Prop :=
  ∀ ⦃x : ℕ → X⦄ ⦃a b : X⦄, Tendsto x atTop (𝓝 a) → Tendsto x atTop (𝓝 b) → a = b

/-- A subset which is compact and metrizable as a subspace ("compact metric" in the article, where
"metric" means metrizable). -/
def IsCompactMetrizable (K : Set X) : Prop :=
  IsCompact K ∧ MetrizableSpace K

/-- A *metric continuum* contained in `X`: a nonempty, compact, connected, metrizable subspace.
(`IsConnected` includes nonemptiness.) -/
def IsMetricContinuum (K : Set X) : Prop :=
  IsCompact K ∧ IsConnected K ∧ MetrizableSpace K

/-- A *quasi-Peano space* contained in `X`: a compact, locally connected, metrizable subspace. -/
def IsQuasiPeano (K : Set X) : Prop :=
  IsCompact K ∧ MetrizableSpace K ∧ LocallyConnectedSpace K

/-- A *Peano continuum* contained in `X`: a locally connected metric continuum. -/
def IsPeanoContinuum (K : Set X) : Prop :=
  IsMetricContinuum K ∧ LocallyConnectedSpace K

/-- A family of closed subsets covering `X` with which the topology of `X` is coherent: a set is
closed if it meets every member in a closed set. -/
structure IsMosaicFamily (𝒦 : Set (Set X)) : Prop where
  /-- The members cover `X`. -/
  cover : ∀ x : X, ∃ K ∈ 𝒦, x ∈ K
  /-- Every member is closed. -/
  isClosed : ∀ K ∈ 𝒦, IsClosed K
  /-- A set meeting every member in a closed set is closed. -/
  coherent : ∀ M : Set X, (∀ K ∈ 𝒦, IsClosed (M ∩ K)) → IsClosed M

/-- `X` is a *mosaic space*: its topology is coherent with a covering family of closed subspaces
that are compact and metrizable. -/
def IsMosaicSpace (X : Type u) [TopologicalSpace X] : Prop :=
  ∃ 𝒦 : Set (Set X), IsMosaicFamily 𝒦 ∧ ∀ K ∈ 𝒦, IsCompactMetrizable K

/-- `X` is an *m-continuum space*: a mosaic space of a mosaic of metric continua. -/
def IsMContinuumSpace (X : Type u) [TopologicalSpace X] : Prop :=
  ∃ 𝒦 : Set (Set X), IsMosaicFamily 𝒦 ∧ ∀ K ∈ 𝒦, IsMetricContinuum K

/-- `X` is a *quasi-curve space*: a mosaic space of a mosaic of quasi-Peano spaces. -/
def IsQuasiCurveSpace (X : Type u) [TopologicalSpace X] : Prop :=
  ∃ 𝒦 : Set (Set X), IsMosaicFamily 𝒦 ∧ ∀ K ∈ 𝒦, IsQuasiPeano K

/-- `X` is a *curve space*: a mosaic space of a mosaic of Peano continua. -/
def IsCurveSpace (X : Type u) [TopologicalSpace X] : Prop :=
  ∃ 𝒦 : Set (Set X), IsMosaicFamily 𝒦 ∧ ∀ K ∈ 𝒦, IsPeanoContinuum K

/-- Every convergent sequence has a subsequence lying, together with its limit, in a set with
property `P`. -/
def Captures (X : Type u) [TopologicalSpace X] (P : Set X → Prop) : Prop :=
  ∀ (u : ℕ → X) (a : X), Tendsto u atTop (𝓝 a) →
    ∃ K, P K ∧ a ∈ K ∧ ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ n, u (φ n) ∈ K

/-- The image of a path. -/
def IsPathImage (L : Set X) : Prop := ∃ (a b : X) (γ : Path a b), range γ = L

/-- **Definition 2.11**: a set is *m-strongly connected* if any two of its points lie in a metric
continuum contained in it. -/
def MStronglyConnected (s : Set X) : Prop :=
  ∀ x ∈ s, ∀ y ∈ s, ∃ L ⊆ s, IsMetricContinuum L ∧ x ∈ L ∧ y ∈ L

/-- **Definition 2.11**: every open set containing a point contains an open m-strongly connected
set containing the point. -/
def LocallyMStronglyConnected (X : Type u) [TopologicalSpace X] : Prop :=
  ∀ (x : X) (O : Set X), IsOpen O → x ∈ O → ∃ W, IsOpen W ∧ x ∈ W ∧ W ⊆ O ∧ MStronglyConnected W

/-- An arc in `s` from `x` to `y`: a topological embedding of `[0,1]` with image in `s`,
`0 ↦ x`, `1 ↦ y`. -/
def IsArcBetween (s : Set X) (x y : X) : Prop :=
  ∃ f : unitInterval → X, IsEmbedding f ∧ f 0 = x ∧ f 1 = y ∧ range f ⊆ s

/-- A set is *arcwise connected* if any two distinct points of it are the end points of an arc
contained in it (article, after Definition 2.11). -/
def ArcwiseConnected (s : Set X) : Prop :=
  ∀ x ∈ s, ∀ y ∈ s, x ≠ y → IsArcBetween s x y

/-- Local arcwise connectedness in the article's open-set form. -/
def LocallyArcwiseConnected (X : Type u) [TopologicalSpace X] : Prop :=
  ∀ (x : X) (O : Set X), IsOpen O → x ∈ O → ∃ W, IsOpen W ∧ x ∈ W ∧ W ⊆ O ∧ ArcwiseConnected W

/-- A subset is an *arc* if it is homeomorphic to `[0,1]` (as the image of an embedding). -/
def IsArc (A : Set X) : Prop :=
  ∃ f : unitInterval → X, IsEmbedding f ∧ range f = A

/-- A family `Ps` *determines* `X`: a set meeting every member in a relatively closed set is
closed. -/
def Determines (Ps : Set (Set X)) : Prop :=
  ∀ F : Set X, (∀ P ∈ Ps, IsClosed ((Subtype.val : P → X) ⁻¹' F)) → IsClosed F

/-- `X` is *path-determined*: it is determined by the images of paths. -/
def IsPathDetermined (X : Type u) [TopologicalSpace X] : Prop :=
  Determines {P : Set X | IsPathImage P}

/-- Condition (b) of Proposition 2.10: closedness is tested by preimages under paths. -/
def ClosedTestedByPaths (X : Type u) [TopologicalSpace X] : Prop :=
  ∀ F : Set X, (∀ γ : C(unitInterval, X), IsClosed (γ ⁻¹' F)) → IsClosed F

/-- Condition (c) of Proposition 2.10: `X` is a quotient of a topological sum of copies of
`[0,1]`. -/
def IsQuotientOfIntervals (X : Type u) [TopologicalSpace X] : Prop :=
  ∃ (ι : Type u) (q : (Σ _ : ι, unitInterval) → X), IsQuotientMap q

end Defs

section AbstractDefs

variable {X : Type u}

/-- **Definition 2.1**: a mosaic on the set `X`: pieces `S α ⊆ X` with topologies `τ α`, covering
`X`, such that the trace on `S β` of a `τ α`-closed subset of `S α` is `τ β`-closed. -/
structure IsAbstractMosaic {A : Type u} (S : A → Set X) (τ : ∀ α, TopologicalSpace (S α)) :
    Prop where
  cover : ∀ x : X, ∃ α, x ∈ S α
  compat : ∀ α β (M : Set (S α)), IsClosed[τ α] M →
    IsClosed[τ β] {y : S β | (y : X) ∈ (Subtype.val '' M : Set X)}

/-- **Definition 2.1**: the mosaic topology: `M` is closed iff every trace `M ∩ S α` is
`τ α`-closed (the final topology of the inclusions). -/
def mosaicTopology {A : Type u} (S : A → Set X) (τ : ∀ α, TopologicalSpace (S α)) :
    TopologicalSpace X :=
  ⨆ α, @TopologicalSpace.coinduced (S α) X Subtype.val (τ α)

/-- An abstract mosaic space (Definition 2.1) whose pieces are compact metrizable spaces with
property `P`, carrying the mosaic topology. -/
def IsAbstractMosaicSpaceWith (P : ∀ Z : Type u, TopologicalSpace Z → Prop) (X : Type u)
    [t : TopologicalSpace X] : Prop :=
  ∃ (A : Type u) (S : A → Set X) (τ : ∀ α, TopologicalSpace (S α)), IsAbstractMosaic S τ ∧
    (∀ α, @CompactSpace _ (τ α) ∧ @MetrizableSpace _ (τ α) ∧ P (S α) (τ α)) ∧
    t = mosaicTopology S τ

end AbstractDefs

/-- The underlying set of the null fan with spines indexed by `J`. -/
def fan (J : Type u) : Set (J → ℝ) :=
  {f | (∀ j, f j ∈ Icc (0 : ℝ) 1) ∧ ∀ j j', j ≠ j' → f j = 0 ∨ f j' = 0}

/-- The null fan `Fan(J)`. -/
abbrev Fan (J : Type u) := ↥(fan J)

namespace Fan

variable {J : Type u}

/-- The article's metric `φ` on `Fan(J)` for an injection `ν` (the article's `ν` is `ν + 1`). -/
noncomputable def phi (ν : J → ℕ) (f g : Fan J) : ℝ :=
  ∑' j, |(f : J → ℝ) j - (g : J → ℝ) j| / ((ν j : ℝ) + 1)

end Fan

/-- The family `𝒞` of the article: infinite subsets of `ℕ × ℕ` all of whose sections
`{i | (n, i) ∈ Y}` are finite. -/
def IsC (Y : Set (ℕ × ℕ)) : Prop :=
  Y.Infinite ∧ ∀ n, {i | (n, i) ∈ Y}.Finite

/-- A maximal almost disjoint subfamily of `𝒞`, in the form used by the article (display (4.1)). -/
structure IsMADFamily (𝒟 : Set (Set (ℕ × ℕ))) : Prop where
  mem : ∀ D ∈ 𝒟, IsC D
  almostDisjoint : 𝒟.Pairwise fun D D' => (D ∩ D').Finite
  maximal : ∀ Y, IsC Y → ∃ D ∈ 𝒟, (D ∩ Y).Infinite

section ConeDefs

open unitInterval

variable {Y : Type u} [TopologicalSpace Y]

/-- The relation collapsing `Y × {1}`. -/
def coneSetoid (Y : Type u) : Setoid (Y × I) where
  r p q := p = q ∨ (p.2 = 1 ∧ q.2 = 1)
  iseqv := ⟨fun p => Or.inl rfl,
    fun h => h.elim (fun e => Or.inl e.symm) fun h => Or.inr ⟨h.2, h.1⟩,
    fun h h' => by
      rcases h with rfl | ⟨h1, h2⟩
      · exact h'
      · rcases h' with rfl | ⟨h3, h4⟩
        · exact Or.inr ⟨h1, h2⟩
        · exact Or.inr ⟨h1, h4⟩⟩

/-- The cone `𝖼 Y`: the quotient of `Y × [0,1]` collapsing `Y × {1}` to a point. -/
def Cone (Y : Type u) [TopologicalSpace Y] : Type u := Quotient (coneSetoid Y)

instance : TopologicalSpace (Cone Y) := inferInstanceAs (TopologicalSpace (Quotient _))

namespace Cone

/-- The quotient map `κ : Y × [0,1] → 𝖼 Y`. -/
def mk : Y × I → Cone Y := Quotient.mk _

/-- The vertex of the cone over a nonempty space. -/
noncomputable def vertex [Nonempty Y] : Cone Y := mk (Classical.arbitrary Y, 1)

end Cone

end ConeDefs

/-- The condition (H) of Theorem 7.4: every nonempty open subspace is an m-continuum space. -/
def AllOpenMContinuum (X : Type*) [TopologicalSpace X] : Prop :=
  ∀ U : Set X, IsOpen U → U.Nonempty → IsMContinuumSpace U

namespace Paper

variable {X : Type u} [TopologicalSpace X]

/-! ## Section 2 -/

/-- **Proposition 2.3(2)**: a mosaic space is `T₁`. -/
theorem prop_2_3_t1 (hX : IsMosaicSpace X) : T1Space X := sorry

/-- **Lemma 2.4**: in a sequential space with unique sequential limits, a continuous image of a
compact metrizable space is closed, compact and metrizable. -/
theorem lemma_2_4 [SequentialSpace X] (hX : UniqueSeqLimits X) {C : Type u} [TopologicalSpace C]
    [CompactSpace C] [MetrizableSpace C] {f : C → X} (hf : Continuous f) :
    IsClosed (range f) ∧ IsCompact (range f) ∧ MetrizableSpace (range f) := sorry

/-- **Corollary 2.6(1)**: the union of two metric continua with a common point is a metric
continuum. -/
theorem cor_2_6_union [SequentialSpace X] (hX : UniqueSeqLimits X) {K L : Set X}
    (hK : IsMetricContinuum K) (hL : IsMetricContinuum L) (hKL : (K ∩ L).Nonempty) :
    IsMetricContinuum (K ∪ L) := sorry

/-- **Proposition 2.7** (Davison): a space is a mosaic space iff it is sequential with unique
sequential limits. -/
theorem prop_2_7 : IsMosaicSpace X ↔ SequentialSpace X ∧ UniqueSeqLimits X := sorry

/-- **Proposition 2.7**: every Hausdorff sequential space is a mosaic space. -/
theorem prop_2_7_t2 [T2Space X] [SequentialSpace X] : IsMosaicSpace X := sorry

/-- **Proposition 2.7**: open subspaces of mosaic spaces are mosaic spaces. -/
theorem prop_2_7_open (hX : IsMosaicSpace X) {U : Set X} (hU : IsOpen U) : IsMosaicSpace U :=
  sorry

/-- **Lemma 2.8**: a covering family of compact metrizable subspaces of a mosaic space is a mosaic
family iff it captures convergent sequences. -/
theorem lemma_2_8 (hX : IsMosaicSpace X) {𝒦 : Set (Set X)}
    (hcm : ∀ K ∈ 𝒦, IsCompactMetrizable K) (hcover : ∀ x : X, ∃ K ∈ 𝒦, x ∈ K) :
    IsMosaicFamily 𝒦 ↔ Captures X (· ∈ 𝒦) := sorry

/-- **Corollary 2.9(1)** (Lavallee, Theorem 2.1). -/
theorem cor_2_9_1 (hX : IsMosaicSpace X) :
    IsMContinuumSpace X ↔ Captures X IsMetricContinuum := sorry

/-- **Corollary 2.9(2)**, conditions (a), (b), (c): quasi-curve space, curve space, and capture by
Peano continua are equivalent for mosaic spaces. -/
theorem cor_2_9_2 (hX : IsMosaicSpace X) :
    [IsQuasiCurveSpace X, IsCurveSpace X, Captures X IsPeanoContinuum].TFAE := sorry

/-- **Corollary 2.9(2)**, (d) ⇒ (b). -/
theorem cor_2_9_2_path (hX : IsMosaicSpace X) (h : Captures X IsPathImage) : IsCurveSpace X :=
  sorry

/-- **Corollary 2.9**: a quasi-curve space is an m-continuum space. -/
theorem cor_2_9_qc (h : IsQuasiCurveSpace X) : IsMContinuumSpace X := sorry

/-- Display **(2.1)**, the parts proved: in a mosaic space, locally path connected ⇒ locally
m-strongly connected ⇒ locally connected; locally arcwise connected ⇒ locally path connected. -/
theorem display_2_1 (hX : IsMosaicSpace X) :
    (LocallyArcwiseConnected X → LocallyPathConnectedSpace X) ∧
    (LocallyPathConnectedSpace X → LocallyMStronglyConnected X) ∧
    (LocallyMStronglyConnected X → LocallyConnectedSpace X) := sorry

/-- **The arc theorem** (classical; used in Corollary 2.6(2)): in a Hausdorff space two distinct
points joined by a path are the end points of an arc contained in the image of the path. -/
theorem arc_theorem [T2Space X] {x y : X} (γ : Path x y) (hxy : x ≠ y) :
    ∃ f : unitInterval → X, IsEmbedding f ∧ f 0 = x ∧ f 1 = y ∧ range f ⊆ range γ := sorry

/-- **Corollary 2.6(2)**, arcwise part: in a sequential space with unique sequential limits (e.g. a
mosaic space), two distinct points joined by a path in `s` are joined by an arc in `s`. -/
theorem cor_2_6_2_arc [SequentialSpace X] (hX : UniqueSeqLimits X) {s : Set X} {x y : X}
    (h : JoinedIn s x y) (hxy : x ≠ y) : IsArcBetween s x y := sorry

/-- **Display (2.1)**, first line: in a mosaic space, locally arcwise connected ⟺ locally path
connected. -/
theorem display_2_1_iff (hX : IsMosaicSpace X) :
    LocallyArcwiseConnected X ↔ LocallyPathConnectedSpace X := sorry

/-- **Proposition 2.12** (Lavallee, Theorem 5.2). -/
theorem prop_2_12 (hX : IsMosaicSpace X)
    (h : ∀ U : Set X, IsOpen U → U.Nonempty → IsMContinuumSpace U) :
    LocallyMStronglyConnected X := sorry

/-- **Proposition 2.13**: open subspaces of quasi-curve spaces are m-continuum spaces. -/
theorem prop_2_13 (h : IsQuasiCurveSpace X) {U : Set X} (hU : IsOpen U) : IsMContinuumSpace U :=
  sorry

/-- **Lemma 2.14** (with the hypothesis imposed on the pieces that are not locally path connected):
the path components of every open set are open and arcwise connected, and the space is locally
arcwise connected. -/
theorem lemma_2_14 {𝒦 : Set (Set X)} (h𝒦 : IsMosaicFamily 𝒦)
    (hcm : ∀ K ∈ 𝒦, IsCompactMetrizable K)
    (hK : ∀ K ∈ 𝒦, LocallyPathConnectedSpace K ∨
      ∀ (O : Set X), IsOpen O → ∀ z ∈ O ∩ K, ∀ v : ℕ → X, (∀ n, v n ∈ K) →
        Tendsto v atTop (𝓝 z) → ∀ᶠ n in atTop, v n ∈ pathComponentIn O z) :
    (∀ O : Set X, IsOpen O → ∀ x ∈ O,
      IsOpen (pathComponentIn O x) ∧ ArcwiseConnected (pathComponentIn O x)) ∧
    LocallyArcwiseConnected X := sorry

/-- **Definition 2.1** vs. the intrinsic definition: `X` is a mosaic space iff its topology is the
mosaic topology of an abstract mosaic of compact metrizable spaces. -/
theorem def_2_1_mosaic : IsMosaicSpace X ↔ IsAbstractMosaicSpaceWith (fun _ _ => True) X := sorry

/-- **Definition 2.1**, m-continuum spaces: pieces are metric continua. -/
theorem def_2_1_mContinuum :
    IsMContinuumSpace X ↔ IsAbstractMosaicSpaceWith (fun Z t => @ConnectedSpace Z t) X := sorry

/-- **Definition 2.1**, quasi-curve spaces: pieces are quasi-Peano spaces. -/
theorem def_2_1_quasiCurve :
    IsQuasiCurveSpace X ↔ IsAbstractMosaicSpaceWith (fun Z t => @LocallyConnectedSpace Z t) X := sorry

/-- **Definition 2.1**, curve spaces: pieces are Peano continua. -/
theorem def_2_1_curve :
    IsCurveSpace X ↔ IsAbstractMosaicSpaceWith
      (fun Z t => @ConnectedSpace Z t ∧ @LocallyConnectedSpace Z t) X := sorry

/-- **Lemma 2.2**: pieces whose pairwise intersections are closed in both, with the same induced
topology, form a mosaic. -/
theorem lemma_2_2 {Z A : Type u} {S : A → Set Z} {τ : ∀ α, TopologicalSpace (S α)}
    (hcover : ∀ x : Z, ∃ α, x ∈ S α)
    (hcl : ∀ α β, IsClosed[τ α] {y : S α | (y : Z) ∈ S β})
    (hhom : ∀ α β, @Continuous {y : S α | (y : Z) ∈ S β} {y : S β | (y : Z) ∈ S α}
      (@instTopologicalSpaceSubtype _ _ (τ α)) (@instTopologicalSpaceSubtype _ _ (τ β))
      fun y => ⟨⟨y.1.1, y.2⟩, y.1.2⟩) :
    IsAbstractMosaic S τ := sorry

/-- **Proposition 2.3(1)**: each piece is closed in the mosaic topology, which induces the piece
topology on it. -/
theorem prop_2_3_1 {Z A : Type u} {S : A → Set Z} {τ : ∀ α, TopologicalSpace (S α)}
    (hM : IsAbstractMosaic S τ) (α : A) :
    @IsClosedEmbedding (S α) Z (τ α) (mosaicTopology S τ) Subtype.val := sorry

/-- **Corollary 2.9(2)**, all four conditions: (a) quasi-curve space, (b) curve space, (c) capture
by Peano continua, (d) capture by images of paths. -/
theorem cor_2_9_2_full (hX : IsMosaicSpace X) :
    [IsQuasiCurveSpace X, IsCurveSpace X, Captures X IsPeanoContinuum,
      Captures X IsPathImage].TFAE := sorry

/-- **Proposition 2.10**: for a Hausdorff space, path-determined ⇔ closedness tested by paths ⇔
quotient of a topological sum of copies of `[0,1]` ⇔ curve space ⇔ quasi-curve space. -/
theorem prop_2_10 [T2Space X] :
    [IsPathDetermined X, ClosedTestedByPaths X, IsQuotientOfIntervals X, IsCurveSpace X,
      IsQuasiCurveSpace X].TFAE := sorry

/-- **Lemma 2.14**, with the article's hypothesis (imposed on the pieces that are not locally
connected). -/
theorem lemma_2_14_article {𝒦 : Set (Set X)} (h𝒦 : IsMosaicFamily 𝒦)
    (hcm : ∀ K ∈ 𝒦, IsCompactMetrizable K)
    (hK : ∀ K ∈ 𝒦, ¬ LocallyConnectedSpace K →
      ∀ (O : Set X), IsOpen O → ∀ z ∈ O ∩ K, ∀ v : ℕ → X, (∀ n, v n ∈ K) →
        Tendsto v atTop (𝓝 z) → ∀ᶠ n in atTop, v n ∈ pathComponentIn O z) :
    (∀ O : Set X, IsOpen O → ∀ x ∈ O,
      IsOpen (pathComponentIn O x) ∧ ArcwiseConnected (pathComponentIn O x)) ∧
    LocallyArcwiseConnected X := sorry

/-- **Corollary 2.15**: a quasi-curve space is locally arcwise connected (the path components of
its open sets are open and arcwise connected), hence locally m-strongly connected. -/
theorem cor_2_15 (h : IsQuasiCurveSpace X) :
    (∀ O : Set X, IsOpen O → ∀ x ∈ O,
      IsOpen (pathComponentIn O x) ∧ ArcwiseConnected (pathComponentIn O x)) ∧
    LocallyArcwiseConnected X ∧ LocallyMStronglyConnected X := sorry

/-- Classical fact (conventions, line 126; used through Lemma 2.14): a compact, locally connected
metrizable space is locally path connected. -/
theorem compact_locallyConnected_lpc {Z : Type u} [TopologicalSpace Z] [CompactSpace Z]
    [MetrizableSpace Z] [LocallyConnectedSpace Z] : LocallyPathConnectedSpace Z := sorry

/-- Classical facts (conventions, line 126): a Peano continuum is path connected, arcwise
connected, locally path connected and locally arcwise connected, and contains an arc if it has two
points. -/
theorem peano_classical {K : Set X} (h : IsPeanoContinuum K) :
    IsPathConnected K ∧ ArcwiseConnected K ∧ LocallyPathConnectedSpace K ∧
      LocallyArcwiseConnected K ∧ ∀ x ∈ K, ∀ y ∈ K, x ≠ y → ∃ A ⊆ K, IsArc A := sorry

/-- Classical fact (conventions, line 126): a quasi-Peano space has finitely many components,
each open and a Peano continuum. -/
theorem quasiPeano_components {K : Set X} (h : IsQuasiPeano K) :
    (range fun a : K => connectedComponent a).Finite ∧
    ∀ a : K, IsOpen (connectedComponent a) ∧
      IsPeanoContinuum ((↑) '' connectedComponent a : Set X) := sorry

/-- **Lemma 2.2**, first special case: closed subspaces of a space `Z` covering `Y ⊆ Z` form a
mosaic on `Y`. -/
theorem lemma_2_2_closed {Z A : Type u} [TopologicalSpace Z] {Y : Set Z} {S : A → Set Y}
    (hcover : ∀ y : Y, ∃ α, y ∈ S α) (hcl : ∀ α, IsClosed ((Subtype.val '' S α : Set Z))) :
    IsAbstractMosaic S fun _ => inferInstance := sorry

/-- **Lemma 2.2**, second special case: `T₁` spaces with finite pairwise intersections form a
mosaic. -/
theorem lemma_2_2_finite {Z A : Type u} {S : A → Set Z} {τ : ∀ α, TopologicalSpace (S α)}
    (hcover : ∀ x : Z, ∃ α, x ∈ S α) (hT1 : ∀ α, @T1Space _ (τ α))
    (hfin : ∀ α β, α ≠ β → (S α ∩ S β).Finite) : IsAbstractMosaic S τ := sorry

/-- **Proposition 2.3(3)**: the natural map from the topological sum of the pieces is a quotient
map; equivalently, continuity is tested on the pieces. -/
theorem prop_2_3_3 {Z : Type*} [TopologicalSpace Z] {𝒦 : Set (Set X)} (h𝒦 : IsMosaicFamily 𝒦) :
    IsQuotientMap (fun p : Σ K : 𝒦, (K : Set X) => (p.2 : X)) ∧
      ∀ f : X → Z, Continuous f ↔ ∀ K ∈ 𝒦, Continuous fun y : K => f y := sorry

/-- **Proposition 2.3(4), (5), (6)** for a mosaic of compact metrizable pieces: a convergent
sequence has a subsequence lying, with its limit, in one piece; limits of sequences are unique;
the space is sequential. -/
theorem prop_2_3_456 {𝒦 : Set (Set X)} (h𝒦 : IsMosaicFamily 𝒦)
    (hcm : ∀ K ∈ 𝒦, IsCompactMetrizable K) :
    (∀ (u : ℕ → X) (a : X), Tendsto u atTop (𝓝 a) →
      ∃ K ∈ 𝒦, a ∈ K ∧ ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∀ n, u (ψ n) ∈ K) ∧
    UniqueSeqLimits X ∧ SequentialSpace X := sorry

/-- **Remark 2.5**: in a Hausdorff space the continuous image of a compact metrizable space is
closed, compact and metrizable. -/
theorem remark_2_5 [T2Space X] {C : Type*} [TopologicalSpace C] [CompactSpace C]
    [MetrizableSpace C] {f : C → X} (hf : Continuous f) :
    IsClosed (range f) ∧ IsCompact (range f) ∧ MetrizableSpace (range f) := sorry

/-- **Corollary 2.6(2)**, first sentence: in a sequential space with unique sequential limits
(e.g. a mosaic space) the image of a path is a Peano continuum, and any two points of a path
connected set lie in a metric continuum contained in it. -/
theorem cor_2_6_2 [SequentialSpace X] (hX : UniqueSeqLimits X) :
    (∀ {a b : X} (γ : Path a b), IsPeanoContinuum (range γ)) ∧
    ∀ {s : Set X}, IsPathConnected s → ∀ {a b : X}, a ∈ s → b ∈ s →
      ∃ L ⊆ s, IsMetricContinuum L ∧ a ∈ L ∧ b ∈ L := sorry

/-- **Corollary 2.6(3)**: a null sequence of metric continua through a point has a metric
continuum as union. -/
theorem cor_2_6_3 [SequentialSpace X] (hX : UniqueSeqLimits X) {x : X}
    {K : ℕ → Set X} (hK : ∀ n, IsMetricContinuum (K n)) (hx : ∀ n, x ∈ K n)
    (hnull : ∀ O : Set X, IsOpen O → x ∈ O → ∀ᶠ n in atTop, K n ⊆ O) :
    IsMetricContinuum (⋃ n, K n) := sorry

/-- **Proposition 2.10**, (c) ⇒ (b) for sums indexed in any universe. -/
theorem prop_2_10_quotient {ι : Type*} {q : (Σ _ : ι, unitInterval) → X} (hq : IsQuotientMap q) :
    ClosedTestedByPaths X := sorry

/-! ## Section 3: remark 3.7 -/

/-- **Remark 3.7** (Curtis's example), the implication used there: a first countable, locally
m-strongly connected mosaic space which is not locally path connected is an m-continuum space and
not a quasi-curve space. Curtis's example itself is not formalized. -/
theorem remark_3_7 [FirstCountableTopology X] (hX : IsMosaicSpace X)
    (hloc : LocallyMStronglyConnected X) (hnot : ¬ LocallyPathConnectedSpace X) :
    IsMContinuumSpace X ∧ ¬ IsQuasiCurveSpace X := sorry

/-! ## Section 4: the space `G` -/

/-- **Construction 4.1**: a maximal almost disjoint family exists (Zorn's lemma). -/
theorem exists_madFamily : ∃ 𝒟 : Set (Set (ℕ × ℕ)), IsMADFamily 𝒟 := sorry

/-- **Construction 4.1, Theorems 4.5 and 4.11, Proposition 4.9, Remarks 4.10 and 4.13**, for one
space, in existential form. There are a space `G` (the article's `G`), a point `x` (`∞`), a
sequence `u` (`x_n`), a set `W` (the witnesses) and a family `p` (the points `p_D`) such that:
`G` is a Tychonoff mosaic space, locally path connected and locally arcwise connected, the path
components of its open sets are open and arcwise connected (Proposition 4.7), and it is locally
m-strongly connected; `u → x`; no metric continuum and no path image through `x` contains
infinitely many `u n`; `G` is neither an m-continuum space nor a quasi-curve space; `x` has no
countable neighbourhood base (Remark 4.13(1)); each `p i` has an open neighbourhood containing no
other `p j` (Theorem 4.5); a closed connected set through `x` of countable spread contains only
finitely many `u n` (Proposition 4.9); some closed, connected set through `x`, separable as a subspace, contains
infinitely many `u n` and uncountably many `p i` (Remark 4.10); and `x` and every `u n` lie in the
closure of `W` while no sequence in `W` converges to `x`, so `G` is not Fréchet–Urysohn
(Remark 4.13(2)). -/
theorem theorem_4_11 :
    ∃ (G : Type) (_ : TopologicalSpace G) (x : G) (u : ℕ → G) (W : Set G) (ι : Type) (p : ι → G),
      IsMosaicSpace G ∧ T35Space G ∧ LocallyPathConnectedSpace G ∧ LocallyArcwiseConnected G ∧
      (∀ O : Set G, IsOpen O → ∀ y ∈ O,
        IsOpen (pathComponentIn O y) ∧ ArcwiseConnected (pathComponentIn O y)) ∧
      LocallyMStronglyConnected G ∧
      Tendsto u atTop (𝓝 x) ∧
      (∀ K : Set G, IsMetricContinuum K → x ∈ K → {n | u n ∈ K}.Finite) ∧
      (∀ (a b : G) (γ : Path a b), {n | u n ∈ range γ}.Finite) ∧
      ¬ IsMContinuumSpace G ∧ ¬ IsQuasiCurveSpace G ∧ ¬ (𝓝 x).IsCountablyGenerated ∧
      Function.Injective p ∧ (∀ i, ∃ U : Set G, IsOpen U ∧ p i ∈ U ∧ ∀ j, p j ∈ U → j = i) ∧
      (∀ K : Set G, IsClosed K → IsPreconnected K → x ∈ K →
        (∀ A ⊆ K, (∀ a ∈ A, ∃ U : Set G, IsOpen U ∧ U ∩ A = {a}) → A.Countable) →
        {n | u n ∈ K}.Finite) ∧
      (∃ K : Set G, IsClosed K ∧ IsConnected K ∧ SeparableSpace K ∧ x ∈ K ∧
        {n | u n ∈ K}.Infinite ∧ ¬ {i | p i ∈ K}.Countable) ∧
      (∀ n, u n ∈ closure W) ∧ x ∈ closure W ∧
      (∀ v : ℕ → G, (∀ n, v n ∈ W) → ¬ Tendsto v atTop (𝓝 x)) ∧ ¬ FrechetUrysohnSpace G := sorry

/-- **Answer to Q3** (Corollary 4.12): a locally arcwise connected mosaic space (moreover
Tychonoff) which is not a quasi-curve space, hence (Proposition 2.10) not path-determined. -/
theorem answer_Q3 :
    ∃ (X : Type) (_ : TopologicalSpace X), IsMosaicSpace X ∧ T35Space X ∧
      LocallyArcwiseConnected X ∧
      (∀ O : Set X, IsOpen O → ∀ x ∈ O,
        IsOpen (pathComponentIn O x) ∧ ArcwiseConnected (pathComponentIn O x)) ∧
      ¬ IsQuasiCurveSpace X ∧ ¬ IsMContinuumSpace X ∧ ¬ IsPathDetermined X := sorry

/-- **Section 4.2, null fans**: the article's `φ` is a metric on `Fan(J)` and, for every
injection `ν`, its topology is the topology of `Fan J` (so it does not depend on `ν`, (F1)). -/
theorem fan_metric {J : Type u} (ν : J → ℕ) (hν : Function.Injective ν) :
    (∀ f g h : Fan J, Fan.phi ν f h ≤ Fan.phi ν f g + Fan.phi ν g h) ∧
    (∀ f g : Fan J, Fan.phi ν f g = Fan.phi ν g f) ∧
    (∀ f g : Fan J, Fan.phi ν f g = 0 ↔ f = g) ∧
    ∀ s : Set (Fan J), IsOpen s ↔ ∀ f ∈ s, ∃ ε > 0, ∀ g, Fan.phi ν f g < ε → g ∈ s := sorry

/-! ## Section 5 -/

/-- **Section 5.1** (the example of Franklin and Smith-Thomas), the translation used there: a
Hausdorff, sequential, locally path connected space which is not path-determined is a locally
arcwise connected mosaic space which is not a quasi-curve space. (The space `HE` itself is cited,
not formalized.) -/
theorem sec_5_1_translation [T2Space X] [SequentialSpace X] [LocallyPathConnectedSpace X]
    (h : ¬ IsPathDetermined X) :
    IsMosaicSpace X ∧ LocallyArcwiseConnected X ∧ ¬ IsQuasiCurveSpace X := sorry


/-- **Lemma 5.2** (boundary bumping): in a compact connected Hausdorff space, for an open
`U ≠ K`, every component of `cl U` meets `cl U \ U`. -/
theorem lemma_5_2 {K : Type u} [TopologicalSpace K] [CompactSpace K] [T2Space K]
    [ConnectedSpace K] {U : Set K} (hU : IsOpen U) (hUne : U ≠ univ) {x : K}
    (hx : x ∈ closure U) :
    (connectedComponentIn (closure U) x ∩ (closure U \ U)).Nonempty := sorry

/-! ## Section 6: cones -/

/-- **Lemma 6.1** (Whitehead). -/
theorem lemma_6_1 {A B L : Type*} [TopologicalSpace A] [TopologicalSpace B]
    [TopologicalSpace L] [LocallyCompactSpace L] {q : A → B} (hq : IsQuotientMap q) :
    IsQuotientMap (Prod.map q (id : L → L)) := sorry

/-- **Theorem 6.3(1)**: the cone over a mosaic space is an m-continuum space; the cone over a
nonempty space is contractible. -/
theorem theorem_6_3_1 {Y : Type u} [TopologicalSpace Y] (hY : IsMosaicSpace Y) :
    IsMContinuumSpace (Cone Y) ∧ (Nonempty Y → ContractibleSpace (Cone Y)) := sorry

/-- **Theorem 6.3(2)**. -/
theorem theorem_6_3_2 {Y : Type u} [TopologicalSpace Y] [LocallyPathConnectedSpace Y]
    (hY : IsMosaicSpace Y) :
    LocallyPathConnectedSpace (Cone Y) ∧ LocallyArcwiseConnected (Cone Y) ∧
      LocallyMStronglyConnected (Cone Y) := sorry

/-- **Theorem 6.3(3)**. -/
theorem theorem_6_3_3 {Y : Type u} [TopologicalSpace Y] [Nonempty Y] (hY : IsMosaicSpace Y)
    (hnot : ¬ IsMContinuumSpace Y) :
    IsOpen ({Cone.vertex}ᶜ : Set (Cone Y)) ∧ ¬ IsMContinuumSpace ({Cone.vertex}ᶜ : Set (Cone Y)) :=
  sorry

/-- **Theorem 6.3(5)**. -/
theorem theorem_6_3_5 {Y : Type u} [TopologicalSpace Y]
    (hsep : ∀ y y' : Y, y ≠ y' → ∃ f : Y → ℝ, Continuous f ∧ f y ≠ f y') :
    T2Space (Cone Y) := sorry

/-- **Answer to Q2** (Corollary 6.4): a contractible, Hausdorff, locally arcwise connected (hence
locally m-strongly connected) m-continuum space with an open subspace that is not an m-continuum
space; it is not a quasi-curve space. The converse of Lavallee's Theorem 5.2 fails. -/
theorem answer_Q2 :
    ∃ (X : Type) (_ : TopologicalSpace X), IsMContinuumSpace X ∧ T2Space X ∧
      ContractibleSpace X ∧ LocallyArcwiseConnected X ∧ LocallyMStronglyConnected X ∧
      (∃ U : Set X, IsOpen U ∧ ¬ IsMContinuumSpace U) ∧ ¬ IsQuasiCurveSpace X := sorry

/-- **Answer to Q1b**, via the cone over `G` (remark after Corollary 6.4). -/
theorem answer_Q1b :
    ∃ (X : Type) (_ : TopologicalSpace X), IsMContinuumSpace X ∧ T2Space X ∧
      LocallyArcwiseConnected X ∧ LocallyMStronglyConnected X ∧ ¬ IsQuasiCurveSpace X := sorry

/-- **Answer to Q1a**, via the cone over `G`. -/
theorem answer_Q1a :
    ∃ (X : Type) (_ : TopologicalSpace X), IsMContinuumSpace X ∧ T2Space X ∧
      LocallyConnectedSpace X ∧ ¬ IsQuasiCurveSpace X := sorry

/-- **Theorem 6.3(4)**: for a nonempty mosaic space `Y`, every nonempty open subspace of `𝖼Y` is
an m-continuum space iff every nonempty open subspace of `Y` is. -/
theorem theorem_6_3_4 {Y : Type u} [TopologicalSpace Y] [Nonempty Y] (hY : IsMosaicSpace Y) :
    AllOpenMContinuum (Cone Y) ↔ AllOpenMContinuum Y := sorry

/-- **Proposition 6.2(1)**: `κ` restricts to an open embedding of `Y × [0,1)` onto the
complement of the vertex. -/
theorem prop_6_2_1 {Y : Type u} [TopologicalSpace Y] [Nonempty Y] :
    IsOpenEmbedding (fun p : Y × {t : unitInterval | (t : ℝ) < 1} => Cone.mk (p.1, p.2.1)) ∧
    range (fun p : Y × {t : unitInterval | (t : ℝ) < 1} => Cone.mk (p.1, p.2.1)) =
      ({Cone.vertex}ᶜ : Set (Cone Y)) := sorry

/-- **Proposition 6.2(2)**: for a closed `K ⊆ Y` the map `𝖼K → 𝖼Y` induced by the inclusion is
a closed embedding onto `κ(K × [0,1])`, which is a metric continuum when `K` is nonempty, compact
and metrizable. -/
theorem prop_6_2_2 {Y : Type u} [TopologicalSpace Y] {K : Set Y} (hK : IsClosed K) :
    ∃ e : Cone K → Cone Y, IsClosedEmbedding e ∧ (∀ p : K × unitInterval,
      e (Cone.mk p) = Cone.mk ((p.1 : Y), p.2)) ∧ range e = Cone.mk '' (K ×ˢ univ) ∧
      (IsCompactMetrizable K → K.Nonempty → IsMetricContinuum (Cone.mk '' (K ×ˢ univ))) := sorry

/-- **Proposition 6.2(3)**: the cones over the nonempty pieces form a mosaic of metric continua
of the cone. -/
theorem prop_6_2_3 {Y : Type u} [TopologicalSpace Y] {𝒦 : Set (Set Y)} (h𝒦 : IsMosaicFamily 𝒦)
    (hcm : ∀ K ∈ 𝒦, IsCompactMetrizable K) :
    IsMosaicFamily ((fun K => Cone.mk '' (K ×ˢ univ)) '' {K | K ∈ 𝒦 ∧ K.Nonempty}) ∧
    ∀ P ∈ (fun K => Cone.mk '' (K ×ˢ univ)) '' {K | K ∈ 𝒦 ∧ K.Nonempty}, IsMetricContinuum P := sorry

/-- **Theorem 6.3(5)** in full: if continuous real functions separate the points of `Y`, they
separate the points of `𝖼Y`. -/
theorem theorem_6_3_5_sep {Y : Type u} [TopologicalSpace Y]
    (hsep : ∀ y y' : Y, y ≠ y' → ∃ f : Y → ℝ, Continuous f ∧ f y ≠ f y') :
    ∀ c c' : Cone Y, c ≠ c' → ∃ f : Cone Y → ℝ, Continuous f ∧ f c ≠ f c' := sorry

/-! ## Section 7: first countable spaces; Theorem 7.4 -/

/-- **Proposition 7.1**: in a first countable, locally m-strongly connected mosaic space every
open subspace is an m-continuum space. -/
theorem prop_7_1 [FirstCountableTopology X] (hX : IsMosaicSpace X)
    (hloc : LocallyMStronglyConnected X) {U : Set X} (hU : IsOpen U) : IsMContinuumSpace U := sorry

/-- **Proposition 7.2**: a first countable, locally path connected mosaic space is a curve space. -/
theorem prop_7_2_path [FirstCountableTopology X] (hX : IsMosaicSpace X)
    [LocallyPathConnectedSpace X] : IsCurveSpace X := sorry

/-- **Proposition 7.2**, as stated: a first countable, locally arcwise connected mosaic space is a
quasi-curve space. -/
theorem prop_7_2 [FirstCountableTopology X] (hX : IsMosaicSpace X)
    (hloc : LocallyArcwiseConnected X) : IsQuasiCurveSpace X := sorry

/-- **Theorem 7.4**, the implications `(QC) ⇒ (H) ⇒ (LmS) ⇒ (LC)`. -/
theorem theorem_7_4_impl (hX : IsMosaicSpace X) :
    (IsQuasiCurveSpace X → AllOpenMContinuum X) ∧
    (AllOpenMContinuum X → LocallyMStronglyConnected X) ∧
    (LocallyMStronglyConnected X → LocallyConnectedSpace X) := sorry

/-- **Theorem 7.4**, `(LmS) ⇏ (H)` among m-continuum spaces. -/
theorem theorem_7_4_strict_H_LmS :
    ∃ (X : Type) (_ : TopologicalSpace X), IsMContinuumSpace X ∧ LocallyMStronglyConnected X ∧
      ¬ AllOpenMContinuum X := sorry

/-- After Theorem 7.4: for first countable mosaic spaces (H) ⇔ (LmS). -/
theorem theorem_7_4_firstCountable [FirstCountableTopology X] (hX : IsMosaicSpace X) :
    AllOpenMContinuum X ↔ LocallyMStronglyConnected X := sorry

/-- **Theorem 7.4**, local arcwise connectedness: `(QC) ⇒ LAC ⇒ (LmS)`. -/
theorem theorem_7_4_lac (hX : IsMosaicSpace X) :
    (IsQuasiCurveSpace X → LocallyArcwiseConnected X) ∧
    (LocallyArcwiseConnected X → LocallyMStronglyConnected X) := sorry

/-- After Theorem 7.4: for first countable mosaic spaces `(QC) ⇔ LAC`. -/
theorem theorem_7_4_firstCountable_lac [FirstCountableTopology X] (hX : IsMosaicSpace X) :
    IsQuasiCurveSpace X ↔ LocallyArcwiseConnected X := sorry

/-- **Proposition 7.1**, tail form: at a point with a countable neighbourhood base in which every
open set contains an open m-strongly connected neighbourhood, a sequence converging to it has a
tail lying, with the limit, in one metric continuum inside any given open set. -/
theorem prop_7_1_tail (hX : IsMosaicSpace X) {U : Set X} (hU : IsOpen U) {x : X}
    (hxU : x ∈ U) [(𝓝 x).IsCountablyGenerated]
    (hloc : ∀ O : Set X, IsOpen O → x ∈ O →
      ∃ W, IsOpen W ∧ x ∈ W ∧ W ⊆ O ∧ MStronglyConnected W)
    {u : ℕ → X} (hu : Tendsto u atTop (𝓝 x)) :
    ∃ N, ∃ L ⊆ U, IsMetricContinuum L ∧ x ∈ L ∧ ∀ n ≥ N, u n ∈ L := sorry

/-- **Proposition 7.2**, tail form: at a point with a countable neighbourhood base in which every
open set contains an open path connected neighbourhood, a sequence converging to it has a tail on
one path `f` with `f 1 = x` and `f (1 - 1/(j+1)) = u (N + j)`. No mosaic hypothesis is needed. -/
theorem prop_7_2_tail {x : X} [(𝓝 x).IsCountablyGenerated]
    (hloc : ∀ O : Set X, IsOpen O → x ∈ O → ∃ W, IsOpen W ∧ x ∈ W ∧ W ⊆ O ∧ IsPathConnected W)
    {u : ℕ → X} (hu : Tendsto u atTop (𝓝 x)) :
    ∃ N, ∃ f : C(unitInterval, X), f 1 = x ∧
      ∀ j : ℕ, ∃ t : unitInterval, (t : ℝ) = 1 - 1 / ((j : ℝ) + 1) ∧ f t = u (N + j) := sorry

/-- **Theorem 7.4**: local arcwise connectedness does not imply (H) among m-continuum spaces. -/
theorem theorem_7_4_strict_LAC_H :
    ∃ (X : Type) (_ : TopologicalSpace X), IsMContinuumSpace X ∧ LocallyArcwiseConnected X ∧
      ¬ AllOpenMContinuum X := sorry

